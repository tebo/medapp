# Puerto del backend
PORT=3001

# Secreto para firmar los tokens JWT (¡cámbialo en producción!)
JWT_SECRET=mi_secreto_super_seguro_cambiar_en_produccion

# Duración del token (ej: 7d, 24h, 2h)
JWT_EXPIRES_IN=7d

# Ruta del archivo de la base de datos SQLite
# Usa ':memory:' para tests o una ruta como './data/medapp.db'
DB_FILE=./data/medapp.db

# Base URL del frontend (para CORS)
FRONTEND_URL=http://localhost:5173